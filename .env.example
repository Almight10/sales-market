# Database Configuration
# 1. Gunakan ini untuk PostgreSQL lokal di Docker:
DATABASE_URL="postgresql://postgres:probolinggo@db:5432/dashboard_db?schema=public"
# 2. Atau gunakan ini untuk Neon DB (Cloud) - Ganti dengan URL database Neon Anda:
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-PROJECT-ID.us-east-1.aws.neon.tech/neondb?sslmode=require"

# MINIO Configuration
MINIO_ENDPOINT="minio"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="admin123"
MINIO_BUCKET="erp-storage"

# Microservices URLs
CRM_SERVICE_URL="http://crm-service:3001"
HR_SERVICE_URL="http://hr-service:3002"

# Google OAuth Credentials (Isi dengan kredensial Google Anda)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="f6d6c41b8a5d3f11a842b083c2e17ef4ba18f192b45a90d8a9e4e6293f0b2f0a"
