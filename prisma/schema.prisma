generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Skema untuk Manajemen Pengguna
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   @default("password123")
  role      String   @default("Staff")
  status    String   @default("Aktif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Skema untuk Pesanan
model Order {
  id          String   @id @default(uuid())
  orderNumber String   @unique
  totalAmount Float
  status      String   @default("Diproses")
  createdAt   DateTime @default(now())
}

// Skema untuk Supply Chain Management (SCM)
model Supplier {
  id          String      @id @default(uuid())
  name        String
  contact     String
  inventories Inventory[]
  createdAt   DateTime    @default(now())
}

model Inventory {
  id          String   @id @default(uuid())
  itemName    String
  stock       Int      @default(0)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  status      String   @default("Tersedia")
  updatedAt   DateTime @updatedAt
}
